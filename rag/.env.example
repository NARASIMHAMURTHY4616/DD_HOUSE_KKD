# DD House RAG Environment Configuration

# LLM Provider: "grok", "openai", or leave blank for deterministic grounded engine
LLM_PROVIDER=grok

# xAI / Grok API configuration (Supports multiple keys for automatic rate-limit rotation)

LLM_KEY_COOLDOWN_SECONDS=60
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Embeddings & Vector DB
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_store_db

# Retrieval Configuration
SIMILARITY_THRESHOLD=0.55
TOP_K=4
